# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but ALLOW example/template files to be committed (no real secrets in these)
!.env.production.example
!expo-app/.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Expo
.expo/
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*
dist/

# Database files
db/*.db
*.db

# Uploaded files (may contain sensitive credentials)
upload/

# Generated expo exports
android-dist/
dist/
tool-results/

# Screenshots
*-screenshot.png
*-screenshot.jpeg
*.next-dev-pid
desktop-landing.png
mobile-landing.png
expo-app/Smart_Ride.env
expo-app/.env
smart-ride-mobile/GoogleService-Info.plist
google-services.json
design-files/
upload/
verify-home-logo.png
*.verify-screenshot.png

# Sentry build-time auth token (source map upload)
.env.sentry-build-plugin
# Local production env (real secrets)
.env.production
.qa-screens/

# Disposable QA probes. Named with a leading dot so they never ship;
# the durable suites are scripts/verify-*.ts.
scripts/.qa-*

# Android upload keystore. The signing credential for Play Store uploads —
# it belongs on the build machine and in a password manager, never in a repo.
# gradle.properties (which holds its passwords) is already untracked.
expo-app/keystores/
*.keystore
!expo-app/android/app/debug.keystore
*.jks
