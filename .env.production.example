# ============================================================
# Smart Ride Backend — Environment Variables Template
# ============================================================
# Copy this to .env (local dev) or .env.production (prod), or set each
# variable in your Vercel project settings. This file is committed;
# .env / .env.production are gitignored.
# ============================================================

# ---- Runtime ----
NODE_ENV=production

# ---- Database (Supabase PostgreSQL) ----
# Direct connection (port 5432) — for runtime + migrations:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
# Pooler connection (port 6543) — for high-concurrency serverless:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Auth secrets (generate JWT_SECRET: openssl rand -hex 16) ----
JWT_SECRET=replace_with_32_char_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=https://smartrideug.vercel.app/api

# ---- Internal API keys (generate: openssl rand -hex 16) ----
CRON_SECRET=replace_with_32_char_hex
INTERNAL_API_KEY=replace_with_32_char_hex
SYSTEM_API_KEY=replace_with_32_char_hex

# ---- Public app URLs ----
NEXT_PUBLIC_APP_URL=https://smartrideug.vercel.app
NEXT_PUBLIC_API_URL=https://smartrideug.vercel.app/api
CORS_ALLOWED_ORIGINS=https://smartrideug.vercel.app

# ---- Mapbox (https://account.mapbox.com/access-tokens/) ----
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# ---- POI search provider (OpenStreetMap) ----
# Mapbox has no POI data for Uganda, so /api/mapbox/geocoding searches OSM.
# If GEOAPIFY_API_KEY is set, it uses Geoapify (production, SLA-backed, free
# tier at https://myprojects.geoapify.com). If unset, it falls back to the free
# public Photon instance (no SLA — fine for low traffic). OSM data either way.
GEOAPIFY_API_KEY=

# ---- Firebase Web Config (Firebase Console → Project settings → Web app) ----
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxx:web:xxxx
# REQUIRED for Google Sign-In — backend audience verification.
# Value: the Web OAuth client ID from Google Cloud Console.
# Example: 531949209415-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_web_client_id

# ---- Firebase Admin SDK (push notifications) ----
# Paste the entire service-account JSON as a single minified line.
FIREBASE_SERVICE_ACCOUNT_JSON=your_firebase_service_account_json

# ---- Sentry (error monitoring + tracing + session replay) ----
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn
SENTRY_DSN=your_server_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_org_slug
SENTRY_PROJECT=your_project_slug

# ---- Gemini AI (optional — future AI features) ----
GEMINI_API_KEY=your_gemini_api_key

# ---- Email (Resend) — optional ----
RESEND_API_KEY=your_resend_api_key

# ---- SMS / OTP (Africa's Talking) — REQUIRED for phone OTP login ----
# Without these, OTPs are saved to DB but NOT sent → phone login broken.
# Get API key from: https://account.africastalking.com/apps/sandbox/settings/key
SMS_ENABLED=true
SMS_PROVIDER=africas_talking
AFRICASTALKING_USERNAME=your_africas_talking_username
AFRICASTALKING_API_KEY=your_africas_talking_api_key
AFRICASTALKING_SENDER_ID=SmartRide
# NEVER enable in production:
ALLOW_OTP_IN_RESPONSE=false

# ---- One-time admin seed credentials ----
# These power BOTH the prisma seed scripts (prisma/seed-production-admin.ts)
# AND the /api/admin/setup endpoint. Set them to the agreed production admin
# credentials, then trigger setup once via:
#   curl "https://smartrideug.vercel.app/api/admin/setup?key=YOUR_ACTUAL_KEY_VALUE"
#
# IMPORTANT: Replace YOUR_ACTUAL_KEY_VALUE with the real value you set for
# ADMIN_SETUP_KEY below. Do NOT send the literal placeholder text.
#
# After setup, the admin dashboard login page is at:
#   https://smartrideug.vercel.app/intellects/admin
# (The old /admin/* page routes 308-redirect to /intellects/admin.)
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=replace_with_strong_password
# One-time setup key required to invoke /api/admin/setup. Generate a strong
# random string (e.g. `openssl rand -hex 32`). This is NOT the admin password —
# it is a secret key that authorizes the one-time setup call. Set it here, then
# use the SAME value when calling the endpoint.
ADMIN_SETUP_KEY=replace_with_strong_random_string

# ---- NylonPay (merchant of record — ACTIVE) ----
# Get these from https://dashboard.nylonpay.nilesquad.com
# Sandbox keys start with npk_sandbox_ / nps_sandbox_; live keys with npk_live_ / nps_live_
NYLONPAY_API_KEY=npk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
NYLONPAY_API_SECRET=nps_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
NYLONPAY_WEBHOOK_SECRET=whs_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NYLONPAY_BASE_URL=https://api.nylonpay.nilesquad.com
# Webhook URL to register in the NylonPay dashboard:
#   https://smartrideug.vercel.app/api/payments/nylonpay/callback

# ---- Agora VoIP (in-app voice calling) ----
# Get from https://console.agora.io/ → Project Management
# App ID is semi-public (also set EXPO_PUBLIC_AGORA_APP_ID in the mobile .env).
# App Certificate is SECRET — server-side only, NEVER expose to clients or commit to git.
# Without these, the call system returns fallbackMode: true and calls fail gracefully.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# ---- Direct payment gateways (LEGACY — replaced by NylonPay) ----
# All optional now; server boots in cash-only mode if these are unset.
# MTN_MOMO_SECRET_KEY=
# MTN_MOMO_API_KEY=
# MTN_MOMO_SUBSCRIPTION_KEY=
# AIRTEL_MONEY_SECRET_KEY=
# AIRTEL_MONEY_API_KEY=
# FLUTTERWAVE_SECRET_KEY=
