model FraudAlert {
  id              String           @id @default(cuid())
  userId          String?
  riderId         String?
  taskId          String?
  orderId         String?
  /// Polymorphic subject. userId/riderId above stay as real FKs so the admin
  /// table can join names, but an alert may also target a device or merchant,
  /// and the dashboard groups by entityType.
  entityType      RiskEntityType?
  entityId        String?
  alertType       FraudAlertType
  riskScore       Int              @default(0)
  severity        AlertSeverity
  description     String           @default("")
  indicators      String?
  status          FraudAlertStatus @default(OPEN)
  reviewedBy      String?
  reviewedAt      DateTime?
  resolution      String?
  resolutionNotes String?
  // Manual-review -> ML feedback loop. The admin's verdict on an alert is the
  // training label; riskScoreAtDetection preserves the score the model gave at
  // the time so accuracy can be measured against the outcome.
  riskScoreAtDetection Float?
  detectionMethod      String?  @default("RULE_BASED")
  /// JSON array of FraudPattern.patternCode values that fired.
  detectedPatterns     String?
  /// JSON evidence payload backing the alert.
  evidence             String?
  /// JSON array of SuspiciousActivityLog ids that produced this alert.
  relatedActivityIds   String?
  isFalsePositive      Boolean?
  adminDecision        String?
  mlFeedbackGiven      Boolean  @default(false)
  /// Human-facing reference, e.g. FRA-1730000000000.
  alertNumber          String?  @unique
  resolvedBy           String?
  resolvedAt           DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // userId/riderId were bare columns with no relations, so the admin fraud
  // table could not include the subject and always rendered "N/A".
  user            User?            @relation("UserFraudAlerts", fields: [userId], references: [id], onDelete: SetNull)
  rider           Rider?           @relation("RiderFraudAlerts", fields: [riderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([riderId])
  @@index([entityType, entityId])
  @@index([alertType])
  @@index([status])
  @@index([createdAt])
}

model ApiRateLimit {
