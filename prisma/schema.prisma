generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  phone                    String?                   @unique
  passwordHash             String?
  name                     String
  role                     UserRole                  @default(CLIENT)
  status                   UserStatus                @default(ACTIVE)
  authProvider             String?
  avatarUrl                String?
  appleUserId              String?                   @unique
  emailVerified            DateTime?
  refreshToken             String?
  refreshTokenExpiresAt    DateTime?
  lastLoginAt              DateTime?
  // Default delivery address shown in profile editor.
  // Detailed saved addresses live in SavedAddress.
  address                  String?
  // Global notification preferences (JSON). Stores a single
  // `notificationsEnabled` boolean for the master toggle in
  // the profile screen. Granular per-category preferences are
  // stored in the related NotificationPreference model.
  notificationPreferences  Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  auditLogs                AuditLog[]                @relation("UserAuditLogs")
  cashCollections          CashCollection[]
  conversationParticipants ConversationParticipant[]
  disputes                 Dispute[]
  expoPushTokens           ExpoPushToken[]
  notificationLogs         NotificationLog[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  orders                   Order[]
  payments                 Payment[]
  ratingsGiven             Rating[]                  @relation("RatingFromUser")
  ratingsReceived          Rating[]                  @relation("RatingToUser")
  rider                    Rider?
  merchant                 Merchant?
  savedAddresses           SavedAddress[]
  sessions                 Session[]
  sosAlerts                SOSAlert[]                @relation("UserSOSAlerts")
  tasks                    Task[]
  callerCalls              CallSession[]          @relation("CallerCalls")
  recipientCalls           CallSession[]          @relation("RecipientCalls")
  paymentMethods           UserPaymentMethod[]
  healthProvider           HealthProvider?
  fraudAlerts              FraudAlert[]              @relation("UserFraudAlerts")
  // Intelligent platform layer
  deviceAssociations       UserDeviceAssociation[]
  driverInteractions       DriverRiderInteraction[]
  promotionParticipations  ClientPromotionParticipation[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

// ============================================
// SAVED ADDRESS MODEL
// Stores user's frequently-used locations (Home, Work, etc.)
// ============================================
model SavedAddress {
  id          String   @id @default(cuid())
  userId      String
  label       String   // "Home", "Work", "Other", or custom
  address     String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// SESSION MODEL - Production Auth System
// Supports multi-device sessions with revocation
// ============================================
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String // Hashed refresh token (NEVER store raw token)
  deviceId         String? // Unique device identifier
  deviceName       String? // e.g., "iPhone 14 Pro", "Samsung Galaxy S23"
  deviceType       String? // "ios", "android", "web"
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastAccessedAt   DateTime  @default(now())
  revoked          Boolean   @default(false)
  revokedAt        DateTime?
  revokedReason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revoked])
}

// ============================================
// OTP MODEL - Phone Authentication
// ============================================
model OTP {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String // Hashed OTP (NEVER store raw OTP)
  purpose    String // "login", "register", "reset_password"
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@index([phone])
  @@index([expiresAt])
}

// ============================================
// PASSWORD RESET TOKEN MODEL
// Supports forgot password flow for admin users
// ============================================
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model Rider {
  id                 String           @id @default(cuid())
  userId             String           @unique
  fullName           String
  physicalAddress    String
  phone              String           @unique
  email              String?
  facePhotoUrl       String?
  nationalIdFrontUrl String?
  nationalIdBackUrl  String?
  driverLicenseUrl   String?
  vehiclePhotoUrl    String?
  riderRole          RiderRole
  vehicleType        VehicleType?
  status             RiderStatus      @default(PENDING_APPROVAL)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?
  hasReflectorVest   Boolean          @default(false)
  hasHelmet          Boolean          @default(false)
  hasInsulatedBox    Boolean          @default(false)
  isOnline           Boolean          @default(false)
  currentLatitude    Float?
  currentLongitude   Float?
  geohash            String?
  lastLocationUpdate DateTime?
  rating             Float            @default(5.0)
  totalTrips         Int              @default(0)
  completedTrips     Int              @default(0)
  cancelledTrips     Int              @default(0)
  lastHeartbeatAt    DateTime?
  connectionStatus   ConnectionStatus @default(ACTIVE)
  lastKnownLatitude  Float?
  lastKnownLongitude Float?
  lastKnownSpeed     Float?
  lastKnownBattery   Int?
  lastKnownHeading   Float?
  currentTaskId      String?
  totalEarnings Decimal            @default(0)
  walletBalance Decimal            @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  auditLogs          AuditLog[]       @relation("RiderAuditLogs")
  fraudAlerts        FraudAlert[]     @relation("RiderFraudAlerts")
  // Intelligent platform layer
  reputation         DriverReputation?
  fraudProfile       RiderFraudProfile?
  deviceAssociations RiderDeviceAssociation[]
  gpsAnomalies       GPSAnomaly[]
  clientInteractions DriverRiderInteraction[]
  incentiveParticipations IncentiveParticipation[]
  cashCollections    CashCollection[]
  dispatchMatches    DispatchMatch[]
  heartbeatLogs      HeartbeatLog[]
  transactions       Transaction[]
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  riderPayouts       RiderPayout[]
  sosAlerts          SOSAlert[]       @relation("RiderSOSAlerts")
  tasks              Task[]
  vehicle            Vehicle?

  @@index([riderRole])
  @@index([status])
  @@index([isOnline])
  @@index([currentLatitude, currentLongitude])
  @@index([geohash])
}

model Vehicle {
  id                 String   @id @default(cuid())
  riderId            String   @unique
  make               String
  model              String
  year               Int?
  color              String
  plateNumber        String   @unique
  registrationDocUrl String?
  insuranceDocUrl    String?
  inspectionDocUrl   String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  rider              Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([plateNumber])
}

model Merchant {
  id                 String         @id @default(cuid())
  userId             String?        @unique
  user               User?          @relation(fields: [userId], references: [id])
  name               String
  type               MerchantType
  description        String?
  phone              String
  email              String?
  address            String
  latitude           Float?
  longitude          Float?
  city               String?
  isOpen             Boolean        @default(false)
  openingTime        String?
  closingTime        String?
  averagePrepTime    Int            @default(15)
  commissionRate     Float          @default(0.15)
  bankAccountName    String?
  bankAccountNumber  String?
  bankName           String?
  status             MerchantStatus @default(PENDING_APPROVAL)
  verifiedAt         DateTime?
  verifiedBy         String?
  logoUrl            String?
  coverImageUrl      String?
  businessLicenseUrl String?
  totalOrders        Int            @default(0)
  rating             Float          @default(5.0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  auditLogs          AuditLog[]     @relation("MerchantAuditLogs")
  kots               KOT[]
  menuItems          MenuItem[]
  orders             Order[]
  pharmacy           Pharmacy?

  @@index([type])
  @@index([status])
  @@index([isOpen])
  @@index([latitude, longitude])
}

model MenuItem {
  id              String                 @id @default(cuid())
  merchantId      String
  name            String
  description     String?
  price Decimal
  imageUrl        String?
  category        String?
  isAvailable     Boolean                @default(true)
  stockQuantity   Int?
  preparationTime Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  merchant        Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  variants        ProductVariant[]
  reservations    InventoryReservation[]

  @@index([merchantId])
  @@index([category])
}

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique
  clientId             String
  merchantId           String?
  orderType            OrderType
  subtotal Decimal
  deliveryFee Decimal
  serviceFee Decimal?
  discount Decimal?
  totalAmount Decimal
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(PENDING)
  paymentReference     String?
  status               OrderStatus   @default(ORDER_CREATED)
  deliveryAddress      String
  deliveryLatitude     Float?
  deliveryLongitude    Float?
  deliveryInstructions String?
  recipientName        String?
  recipientPhone       String?
  confirmedAt          DateTime?
  acceptedAt           DateTime?
  preparingAt          DateTime?
  readyAt              DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  auditLogs            AuditLog[]    @relation("OrderAuditLogs")
  kot                  KOT?
  client               User          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  merchant             Merchant?     @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  payments             Payment[]
  task                 Task?

  @@index([clientId])
  @@index([merchantId])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
  @@index([merchantId, status])
  @@index([clientId, status])
}

model OrderItem {
  id                  String    @id @default(cuid())
  orderId             String
  menuItemId          String?
  itemName            String
  itemDescription     String?
  quantity            Int
  unitPrice Decimal
  totalPrice Decimal
  specialInstructions String?
  createdAt           DateTime  @default(now())
  menuItem            MenuItem? @relation(fields: [menuItemId], references: [id])
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model KOT {
  id                  String    @id @default(cuid())
  kotNumber           String    @unique
  orderId             String    @unique
  merchantId          String
  status              KOTStatus @default(GENERATED)
  items               String
  specialInstructions String?
  estimatedPrepTime   Int?
  printedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  merchant            Merchant  @relation(fields: [merchantId], references: [id])
  order               Order     @relation(fields: [orderId], references: [id])

  @@index([merchantId])
  @@index([status])
}

model Task {
  id                  String                @id @default(cuid())
  taskNumber          String                @unique
  taskType            TaskType
  clientId            String
  riderId             String?
  orderId             String?               @unique
  status              TaskStatus            @default(CREATED)
  pickupAddress       String
  pickupLatitude      Float?
  pickupLongitude     Float?
  pickupContactName   String?
  pickupContactPhone  String?
  dropoffAddress      String
  dropoffLatitude     Float?
  dropoffLongitude    Float?
  dropoffContactName  String?
  dropoffContactPhone String?
  distanceKm          Float?
  estimatedDuration   Int?
  actualDuration      Int?
  baseFare Decimal
  distanceFare Decimal?
  timeFare Decimal?
  deliveryFee Decimal?
  serviceFee Decimal?
  discount Decimal?
  totalAmount Decimal
  platformCommission Decimal?
  riderEarnings Decimal?
  waitingMinutes Int?
  waitingCharge Decimal?
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus         @default(PENDING)
  passengerCount      Int?
  passengerNames      String?
  itemDescription     String?
  itemWeight          Float?
  itemValue Decimal?
  cancellationReason  String?
  cancellationCode    String?
  cancelledBy         String?
  matchingStartedAt   DateTime?
  assignedAt          DateTime?
  acceptedAt          DateTime?
  arrivedAtPickupAt   DateTime?
  pickedUpAt          DateTime?
  inProgressAt        DateTime?
  deliveringAt        DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  lastHeartbeatAt     DateTime?
  lastKnownLatitude   Float?
  lastKnownLongitude  Float?
  connectionStatus    ConnectionStatus?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  healthOrderId       String?               @unique
  auditLogs           AuditLog[]            @relation("TaskAuditLogs")
  conversation        Conversation?
  dispatchMatches     DispatchMatch[]
  dispute             Dispute?
  heartbeatLogs       HeartbeatLog[]
  payment             Payment?
  rating              Rating?
  sosAlerts           SOSAlert[]            @relation("TaskSOSAlerts")
  stateTransitions    TaskStateTransition[]
  transactions        Transaction[]
  client              User                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  healthOrder         HealthOrder?          @relation(fields: [healthOrderId], references: [id])
  order               Order?                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider               Rider?                @relation(fields: [riderId], references: [id])
  calls               CallSession[]

  @@index([taskType])
  @@index([status])
  @@index([clientId])
  @@index([riderId])
  @@index([createdAt])
  @@index([pickupLatitude, pickupLongitude])
  @@index([dropoffLatitude, dropoffLongitude])
  @@index([riderId, status])
  @@index([clientId, status])
  @@index([status, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  paymentReference  String        @unique
  taskId            String?       @unique
  orderId           String?
  userId            String
  amount Decimal
  currency          String        @default("UGX")
  paymentMethod     PaymentMethod
  status            PaymentStatus @default(PENDING)
  transactionId     String?
  providerResponse  String?
  failureReason     String?
  phoneNumber       String?
  momoTransactionId String?
  cardLastFour      String?
  cardBrand         String?
  processedAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order?        @relation(fields: [orderId], references: [id])
  task              Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([userId, status])
}

model RiderPayout {
  id            String       @id @default(cuid())
  riderId       String
  amount Decimal
  currency      String       @default("UGX")
  status        PayoutStatus @default(PENDING)
  periodStart   DateTime
  periodEnd     DateTime
  taskCount     Int
  transactionId String?
  paymentMethod String?
  phoneNumber   String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rider         Rider        @relation(fields: [riderId], references: [id], onDelete: Restrict)

  @@index([riderId])
  @@index([status])
}

model CashCollection {
  id             String           @id @default(cuid())
  riderId        String
  userId         String?
  taskId         String?
  amount Decimal
  currency       String           @default("UGX")
  collectionType CollectionType
  status         CollectionStatus @default(PENDING)
  collectedAt    DateTime?
  depositedAt    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rider          Rider            @relation(fields: [riderId], references: [id], onDelete: Restrict)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([riderId])
  @@index([status])
  @@index([collectionType])
}

model FinanceLog {
  id                 String          @id @default(cuid())
  transactionType    TransactionType
  referenceId        String
  amount Decimal
  currency           String          @default("UGX")
  clientId           String?
  riderId            String?
  merchantId         String?
  platformCommission Decimal?
  riderEarnings Decimal?
  merchantEarnings Decimal?
  status             String
  description        String?
  metadata           String?
  createdAt          DateTime        @default(now())

  @@index([transactionType])
  @@index([referenceId])
  @@index([createdAt])
}

model Rating {
  id                    String   @id @default(cuid())
  taskId                String   @unique
  fromUserId            String
  toUserId              String?
  toRiderId             String?
  score                 Int
  comment               String?
  punctualityScore      Int?
  professionalismScore  Int?
  vehicleConditionScore Int?
  createdAt             DateTime @default(now())
  fromUser              User     @relation("RatingFromUser", fields: [fromUserId], references: [id])
  task                  Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toUser                User?    @relation("RatingToUser", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
}

model AuditLog {
  id            String       @id @default(cuid())
  actorId       String?
  actorType     ActorType
  userId        String?
  riderId       String?
  merchantId    String?
  action        String
  entityType    String
  entityId      String
  orderId       String?
  taskId        String?
  description   String?
  oldValues     String?
  newValues     String?
  ipAddress     String?
  userAgent     String?
  source        String       @default("SYSTEM") // ADMIN_DASHBOARD | MOBILE_APP | API | SYSTEM
  createdAt     DateTime     @default(now())
  healthOrderId String?
  healthOrder   HealthOrder? @relation("HealthOrderAuditLogs", fields: [healthOrderId], references: [id])
  merchant      Merchant?    @relation("MerchantAuditLogs", fields: [merchantId], references: [id])
  order         Order?       @relation("OrderAuditLogs", fields: [orderId], references: [id])
  rider         Rider?       @relation("RiderAuditLogs", fields: [riderId], references: [id])
  task          Task?        @relation("TaskAuditLogs", fields: [taskId], references: [id])
  user          User?        @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([source])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  title         String
  message       String
  type          NotificationType
  referenceId   String?
  referenceType String?
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  surgeAlerts           Boolean  @default(true)
  highDemandAlerts      Boolean  @default(true)
  incentiveAlerts       Boolean  @default(true)
  earningsOpportunities Boolean  @default(true)
  repositionRequests    Boolean  @default(true)
  surgeWarnings         Boolean  @default(true)
  promoAlerts           Boolean  @default(true)
  discountOffers        Boolean  @default(true)
  taskUpdates           Boolean  @default(true)
  orderUpdates          Boolean  @default(true)
  paymentUpdates        Boolean  @default(true)
  systemUpdates         Boolean  @default(true)
  quietHoursEnabled     Boolean  @default(false)
  quietHoursStart       String   @default("22:00")
  quietHoursEnd         String   @default("07:00")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationBroadcast {
  id              String    @id @default(cuid())
  zoneId          String?
  broadcastType   String
  title           String
  message         String
  targetAudience  String
  referenceId     String?
  referenceType   String?
  metadata        String?
  expiresAt       DateTime?
  status          String    @default("PENDING")
  sentAt          DateTime?
  recipientsCount Int       @default(0)
  deliveredCount  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([broadcastType])
  @@index([status])
  @@index([createdAt])
}

model SOSAlert {
  id              String    @id @default(cuid())
  alertNumber     String    @unique
  userId          String?
  riderId         String?
  taskId          String?
  userType        String
  userName        String
  userPhone       String
  riderName       String?
  riderPhone      String?
  vehicleInfo     String?
  taskNumber      String?
  taskType        String?
  latitude        Float
  longitude       Float
  locationAddress String?
  status          SOSStatus @default(ACTIVE)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  actionsTaken    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rider           Rider?    @relation("RiderSOSAlerts", fields: [riderId], references: [id])
  task            Task?     @relation("TaskSOSAlerts", fields: [taskId], references: [id])
  user            User?     @relation("UserSOSAlerts", fields: [userId], references: [id])
  locationUpdates SOSLocationUpdate[]
  incidentReports IncidentReport[]    @relation("SOSAlertIncidentReports")

  @@index([status])
  @@index([createdAt])
}

// Live location trail streamed by the SOS reporter's device while an
// alert is active (POST /api/sos-live-location every ~10s)
model SOSLocationUpdate {
  id           String   @id @default(cuid())
  sosAlertId   String
  latitude     Float
  longitude    Float
  accuracy     Float?
  speed        Float?
  heading      Float?
  batteryLevel Int?
  createdAt    DateTime @default(now())
  sosAlert     SOSAlert @relation(fields: [sosAlertId], references: [id], onDelete: Cascade)

  @@index([sosAlertId, createdAt])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SLAConfig {
  id          String   @id @default(cuid())
  serviceType String
  state       String
  slaMinutes  Int
  // How long a rider has to accept a dispatch offer for this service type
  // (seconds). Null = built-in default. Edited from the admin dashboard;
  // the dispatch engine reads it via lib/api/sla.ts (cached, no redeploy).
  acceptTimeoutSeconds Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceType, state])
}

model PricingConfig {
  id                        String   @id @default(cuid())
  serviceType               String   @unique
  baseFare Decimal
  perKmRate Decimal
  perMinuteRate Decimal?
  minimumFare Decimal
  maximumFare Decimal?
  platformCommissionPercent Float?
  serviceFeePercent         Float?
  nightSurchargePercent     Float?
  peakSurchargePercent      Float?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model HeartbeatLog {
  id               String           @id @default(cuid())
  riderId          String
  taskId           String?
  latitude         Float
  longitude        Float
  speed            Float?
  heading          Float?
  accuracy         Float?
  batteryLevel     Int?
  isCharging       Boolean?
  networkType      String?
  connectionStatus ConnectionStatus @default(ACTIVE)
  metadata         String?
  createdAt        DateTime         @default(now())
  rider            Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)
  task             Task?            @relation(fields: [taskId], references: [id])

  @@index([riderId])
  @@index([taskId])
  @@index([createdAt])
  @@index([connectionStatus])
}

model ConnectionAlert {
  id              String        @id @default(cuid())
  riderId         String
  taskId          String?
  alertType       AlertType
  severity        AlertSeverity
  message         String
  isAcknowledged  Boolean       @default(false)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
