  amount Decimal
  currency         String            @default("UGX")
  balanceBefore Decimal
  balanceAfter Decimal
  status           TransactionStatus @default(COMPLETED)
  paymentMethod    String?
  paymentReference String?
  description      String?
  metadata         String? // JSON for additional data
  processedAt      DateTime          @default(now())
  reversedAt       DateTime?
  reversalReason   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rider            Rider?            @relation(fields: [riderId], references: [id])
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([riderId])
  @@index([merchantId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// SETTLEMENT MODEL
// Payout settlements for riders and merchants
// ============================================
model Settlement {
  id                 String                  @id @default(cuid())
  settlementRef      String                  @unique
  recipientType      SettlementRecipientType
  recipientId        String // Rider ID or Merchant ID
  periodStart        DateTime
  periodEnd          DateTime
  taskCount          Int                     @default(0)
  orderCount         Int                     @default(0)
  grossAmount Decimal
  platformCommission Decimal
  adjustments Decimal                   @default(0)
  netAmount Decimal
  currency           String                  @default("UGX")
  status             SettlementStatus        @default(PENDING)
  paymentMethod      String?
  paymentReference   String?
  processedAt        DateTime?
  paidAt             DateTime?
  failedAt           DateTime?
  failureReason      String?
  processedBy        String? // Admin who processed
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([recipientType])
  @@index([recipientId])
  @@index([status])
  @@index([periodStart])
  @@index([createdAt])
}

// ============================================
// ADMIN PERMISSION MODEL
// Fine-grained RBAC permissions
// ============================================
model AdminPermission {
  id         String   @id @default(cuid())
  role       UserRole
  resource   String // 'riders', 'tasks', 'merchants', 'finance', etc.
  action     String // 'create', 'read', 'update', 'delete', 'approve', 'suspend'
  isAllowed  Boolean  @default(true)
  conditions String? // JSON for conditional permissions
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, resource, action])
  @@index([role])
  @@index([resource])
}

// ============================================
// DISPUTE MODEL
// Dispute handling for tasks and orders
// ============================================
model Dispute {
  id             String          @id @default(cuid())
  disputeNumber  String          @unique
  taskId         String?         @unique
  orderId        String?
  healthOrderId  String?
  clientId       String
  riderId        String?
  merchantId     String?
  disputeType    DisputeType
  category       String
  description    String
  status         DisputeStatus   @default(OPEN)
  priority       DisputePriority @default(MEDIUM)
  resolution     String?
  resolutionType String? // 'REFUND', 'PARTIAL_REFUND', 'CREDIT', 'NO_ACTION'
  refundAmount Decimal?
  creditAmount Decimal?
  openedAt       DateTime        @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  closedAt       DateTime?
  closedBy       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  task           Task?           @relation(fields: [taskId], references: [id])
  client         User            @relation(fields: [clientId], references: [id])

  @@index([taskId])
  @@index([orderId])
  @@index([clientId])
  @@index([riderId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ============================================
// DOCUMENT EXPIRY MODEL
// Tracks document expiration dates
// ============================================
