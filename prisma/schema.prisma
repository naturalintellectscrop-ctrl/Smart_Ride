  provider       String? // 'FCM', 'SMS', 'EMAIL'
  providerRef    String? // Provider message ID
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  retryCount     Int                        @default(0)
  createdAt      DateTime                   @default(now())
