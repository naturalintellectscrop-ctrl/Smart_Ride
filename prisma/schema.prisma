  userId    String
  token     String   @unique
  deviceId  String?
  platform  String? // "ios", "android", "web"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ============================================
// OFFLINE ACTION MODEL
// Offline action queue for sync
// ============================================
model OfflineAction {
  id             String              @id @default(cuid())
  userId         String
  actionType     String // 'CREATE_TASK', 'UPDATE_STATUS', 'CREATE_ORDER', etc.
  entityType     String // 'Task', 'Order', 'HealthOrder'
  entityId       String? // Local ID if created offline
  payload        String // JSON payload
  status         OfflineActionStatus @default(PENDING)
  syncedAt       DateTime?
  syncedEntityId String? // Server ID after sync
  conflictData   String? // JSON for conflict resolution
  resolvedAt     DateTime?
  retryCount     Int                 @default(0)
  deviceId       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([actionType])
  @@index([createdAt])
}

// ============================================
// TASK ANALYTICS MODEL
// Daily aggregated task metrics
// ============================================
model TaskAnalytics {
  id                String   @id @default(cuid())
  date              DateTime
  taskType          TaskType
  totalCreated      Int      @default(0)
  totalCompleted    Int      @default(0)
  totalCancelled    Int      @default(0)
  totalFailed       Int      @default(0)
  avgCompletionTime Int? // Seconds
  avgRating         Float?
  totalRevenue Decimal    @default(0)
  totalCommission Decimal    @default(0)
  avgDistance       Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date, taskType])
  @@index([date])
  @@index([taskType])
}

// ============================================
// PLATFORM METRICS MODEL
// System-wide daily metrics
// ============================================
model PlatformMetrics {
  id                   String   @id @default(cuid())
  date                 DateTime @unique
  activeRiders         Int      @default(0)
  activeClients        Int      @default(0)
  totalTasksCompleted  Int      @default(0)
  totalRevenue Decimal    @default(0)
  totalCommission Decimal    @default(0)
  totalPayouts Decimal    @default(0)
  avgResponseTime      Int? // Seconds
  avgDispatchTime      Int? // Seconds
  customerSatisfaction Float?
  newRegistrations     Int      @default(0)
  disputesOpened       Int      @default(0)
  disputesResolved     Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([date])
}

// ============================================
// WALLET MODEL
// Digital wallet for users, riders, merchants
// ============================================
model Wallet {
  id                String              @id @default(cuid())
  ownerId           String
  ownerType         WalletOwnerType
  balance Decimal               @default(0)
  pendingBalance Decimal               @default(0)
  currency          String              @default("UGX")
  status            WalletStatus        @default(ACTIVE)
  totalDeposited Decimal               @default(0)
  totalWithdrawn Decimal               @default(0)
  totalSpent Decimal               @default(0)
  totalReceived Decimal               @default(0)
  lastDepositAt     DateTime?
  lastWithdrawalAt  DateTime?
  lastTransactionAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  transactions      WalletTransaction[]

  @@unique([ownerId, ownerType])
  @@index([ownerId])
  @@index([ownerType])
  @@index([status])
  @@index([ownerId, ownerType])
}

// ============================================
// WALLET TRANSACTION MODEL
// Tracks all wallet balance changes
// ============================================
model WalletTransaction {
  id                String                  @id @default(cuid())
  walletId          String
  transactionType   WalletTransactionType
  amount Decimal
  balanceBefore Decimal
  balanceAfter Decimal
  referenceId       String?
  referenceType     String?
  externalReference String?
  externalProvider  String?
  description       String?
  status            WalletTransactionStatus @default(COMPLETED)
  metadata          String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  wallet            Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([transactionType])
  @@index([referenceId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// EMERGENCY CONTACT MODEL
// People notified when a user or rider raises an SOS alert.
// NOTE: `userId` is polymorphic — it holds a User.id when userType=CLIENT and
// a Rider.id when userType=RIDER — so it is deliberately NOT a foreign key.
// At most one row per (userId, userType) should have isPrimary=true; the API
// clears the previous primary before setting a new one.
// ============================================
model EmergencyContact {
  id               String                @id @default(cuid())
  userId           String
  userType         EmergencyContactOwner @default(CLIENT)
  name             String
  phone            String
  email            String?
  relationship     String                @default("Other")
  isPrimary        Boolean               @default(false)
  isVerified       Boolean               @default(false)
  verificationCode String?
  verifiedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([userId])
  @@index([userId, userType])
  @@index([isPrimary])
}

enum EmergencyContactOwner {
  CLIENT
  RIDER
}

// ============================================
// USER PAYMENT METHOD MODEL
// Saved mobile-money accounts and cards a user can pay/top-up with.
// Removal is a soft delete (isActive=false) so historical payments keep
// resolving their method; exactly one active row per user is isDefault.
// ============================================
model UserPaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  type          String
  name          String
  accountNumber String?
  cardLastFour  String?
  cardBrand     String?
  phoneNumber   String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([isDefault])
}

// ============================================
// CART MODEL
// Shopping cart for marketplace orders
// ============================================
model Cart {
  id             String     @id @default(cuid())
  userId         String     @unique
