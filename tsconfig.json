{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "expo-app",
    "mobile",
    "mini-services",
    "skills",
    "examples",
    "scripts",
    "prisma",
    "upload",
    "docs",
    "download",
    "App.tsx",
    "capacitor.config.ts",
    "fix-admin-password.ts",
    "src/__tests__",
    "src/services/api.ts",
    "src/services/google-signin.ts",
    "src/services/notifications.ts",
    "src/services/index.ts",
    "src/store/authStore.ts",
    "src/store/locationStore.ts",
    "src/constants/index.ts",
    "src/animations",
    "src/components/animations",
    "src/components/mobile",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts"
  ]
}
