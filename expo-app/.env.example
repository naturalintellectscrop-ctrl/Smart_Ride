# ============================================================
# SMART RIDE MOBILE - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to `.env` and fill in real values.
# EXPO_PUBLIC_* variables are baked into the APK/AAB at BUILD TIME.
# You MUST rebuild the app after changing any value here.
# ============================================================

# ── Backend API ────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://smartrideug.vercel.app/api

# ── Mapbox ─────────────────────────────────────────────────
# PUBLIC token (pk.*) — get from https://account.mapbox.com/access-tokens/
# Required for map rendering. If unset, app fetches from /api/config/mapbox-token.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token_here

# SECRET download token (sk.*) for `npx expo prebuild` SDK download.
# Not needed if android/ folder already exists (local Gradle builds).
# For EAS cloud builds: add as EAS secret instead of here.
# MAPBOX_DOWNLOAD_TOKEN=sk.your_secret_download_token_here

# ── Google Sign-In ─────────────────────────────────────────
# Web OAuth Client ID (client_type 3) from google-services.json
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=531949209415-h0ri57i233r1l767tnc4i26brdt3asb3.apps.googleusercontent.com

# ── Firebase / Google Services ─────────────────────────────
# Copy these values from expo-app/google-services.json exactly.
# Canonical source: google-services.json → client[0].api_key[0].current_key
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyB6d8SCey9MX_fJy6nXx9ycqtNmPw6fuGg
EXPO_PUBLIC_FIREBASE_APP_ID=1:531949209415:android:73229ed013d4d5f507ae62
EXPO_PUBLIC_FIREBASE_PROJECT_ID=smart-ride-774e7
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=531949209415

# ── Supabase (direct mobile access) ────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://mmovwpdgrgdiyqheroak.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Agora VoIP (optional) ───────────────────────────────────
# Falls back to phone dialer if unset.
# EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id_here

# ── Sentry crash reporting (optional) ──────────────────────
# No-ops silently if unset.
# EXPO_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project
