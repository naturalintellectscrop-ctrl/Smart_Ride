# ============================================================
# Smart Ride Mobile — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# This file is committed; .env is gitignored.
# All EXPO_PUBLIC_ vars are inlined into the app bundle at build time.
# ============================================================

# ---- Backend API base URL ----
# Local dev:
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
# Production:
# EXPO_PUBLIC_API_BASE_URL=https://smartrideug.vercel.app/api

# ---- Google Sign-In ----
# Web Client ID (OAuth client type 3) from google-services.json.
# Get it from Firebase Console → Project settings → "Web applications" OAuth client,
# OR read the client_type: 3 entry in expo-app/google-services.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# ---- Firebase config (from google-services.json / GoogleService-Info.plist) ----
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID

# ---- Mapbox (https://account.mapbox.com/access-tokens/) ----
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_TOKEN

# ---- Agora (https://agora.io — in-app calling) ----
EXPO_PUBLIC_AGORA_APP_ID=YOUR_AGORA_APP_ID

# ---- Sentry (https://sentry.io — error tracking) ----
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
