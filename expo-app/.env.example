# ============================================================
# SMART RIDE MOBILE - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to `.env` and fill in real values.
# These EXPO_PUBLIC_* variables are baked into the APK at BUILD TIME.
# You MUST rebuild the APK after changing any value here.
# Run: cd android && ./gradlew assembleRelease
# ============================================================

# Backend API (Next.js on Vercel)
EXPO_PUBLIC_API_BASE_URL=https://smartrideug.vercel.app/api

# Mapbox access token — get one free at https://account.mapbox.com/access-tokens/
# REQUIRED or maps will be blank / the map screen may crash.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1...your-token-here...Q

# Google Sign-In Web OAuth Client ID (client_type 3 in google-services.json)
# Must match the webClientId in src/config/google.ts
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=531949209415-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Firebase Android config (copy from google-services.json)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_APP_ID=1:531949209415:android:xxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_FIREBASE_PROJECT_ID=smart-ride-774e7
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=531949209415

# Supabase (optional — only if the mobile client needs direct Supabase access)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
