# Smart Ride Environment Variables
# Copy this file to .env and fill in your values
# For Vercel deployment, add ALL variables below to your Vercel project settings

# ============================================
# Database Configuration (Supabase PostgreSQL)
# ============================================
# Get these from your Supabase project: Settings → Database → Connection string
# Production (Vercel/Supabase direct host - IPv6):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
# Development/Sandbox (Supabase pooler - IPv4, port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase project credentials (Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# Authentication
# ============================================
# JWT secret - MUST be at least 32 characters in production (REQUIRED)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
JWT_EXPIRES_IN=15m    # Access token expiry (default: 15m)
JWT_REFRESH_EXPIRES_IN=30d  # Refresh token expiry (default: 30d)

# Admin setup key (one-time use for creating first admin)
ADMIN_SETUP_KEY=
DEFAULT_ADMIN_PASSWORD=

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# CORS configuration (comma-separated origins for production)
CORS_ALLOWED_ORIGINS=

# ============================================
# Google Sign-In Configuration
# Get from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# ============================================
# Web client ID (type 3) - Used for server-side audience verification (REQUIRED for Google auth)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Same client ID for Expo mobile app reference
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ============================================
# API Configuration (Mobile App)
# ============================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ============================================
# Mapbox Configuration
# Get your PUBLIC access token from: https://account.mapbox.com/access-tokens/
# You need the PUBLIC token (not the secret one)
# ============================================
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_access_token_here
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_access_token_here
MAPBOX_ACCESS_TOKEN=    # Server-side Mapbox token (can be same as public)

# ============================================
# Supabase
# Get these from: Supabase Dashboard → Settings → API
# ============================================
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key (server-side ONLY — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Expo mobile app equivalents
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# Firebase Configuration
# Get from: Firebase Console > Project Settings > General > Your Apps > Web App
# ============================================
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase VAPID Keys for Push Notifications
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_VAPID_KEY_SECONDARY=

# ============================================
# Payment Gateways
# ============================================

# MTN Mobile Money
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_API_USER=
MTN_MOMO_SECRET_KEY=
MTN_MOMO_CALLBACK_URL=

# Airtel Money
AIRTEL_MONEY_ENVIRONMENT=sandbox
AIRTEL_MONEY_SECRET_KEY=
AIRTEL_MONEY_WEBHOOK_SECRET=
AIRTEL_MONEY_CALLBACK_URL=

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_ENVIRONMENT=sandbox

# ============================================
# Email / SMS
# ============================================
RESEND_API_KEY=
EMAIL_FROM=noreply@smartride.app

# Africa's Talking (SMS/OTP)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africas_talking_api_key
AFRICASTALKING_SENDER_ID=SmartRide

SMS_ENABLED=false
SMS_PROVIDER=africas_talking
# Development only: set to 'true' to include OTP in API response
# NEVER enable in production — this is for testing only
ALLOW_OTP_IN_RESPONSE=false

# ============================================
# Security
# ============================================
CRON_SECRET=            # Secret for Vercel cron job verification
INTERNAL_API_KEY=       # Internal service-to-service API key
SYSTEM_API_KEY=         # System-level API key for webhooks

# Admin safety
ADMIN_ALLOWED_IPS=      # Comma-separated CIDR/IP allowlist (empty = allow all)
ADMIN_SESSION_TIMEOUT=30  # Admin session timeout in minutes

# ============================================
# Logging
# ============================================
LOG_LEVEL=info          # debug, info, warn, error, fatal

# ============================================
# Calling
# ============================================
CALLING_PROVIDER=demo   # demo | twilio | africaistalking
SUPPORT_PHONE=+256700000000
