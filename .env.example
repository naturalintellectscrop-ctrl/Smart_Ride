# Smart Ride Environment Variables
# Copy this file to .env and fill in your values
# For Vercel deployment, add ALL variables below to your Vercel project settings

# ===========================================
# DATABASE (Required for Web App & API)
# ===========================================
# PostgreSQL connection string (REQUIRED)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ===========================================
# AUTHENTICATION (Required for Web App)
# ===========================================
# JWT secret - MUST be at least 32 characters in production (REQUIRED)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
# Base URL for auth callbacks (set to your Vercel URL in production)
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# Google Sign-In Configuration
# Get from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# ===========================================
# Web client ID (type 3) - Used for server-side audience verification (REQUIRED for Google auth)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Same client ID for Expo mobile app reference
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ===========================================
# API Configuration (Mobile App)
# ===========================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ===========================================
# Mapbox Configuration
# Get your PUBLIC access token from: https://account.mapbox.com/access-tokens/
# You need the PUBLIC token (not the secret one)
# ===========================================
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_access_token_here
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_access_token_here

# ===========================================
# Firebase Configuration
# Get from: Firebase Console > Project Settings > General > Your Apps > Web App
# ===========================================
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase VAPID Keys for Push Notifications
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# ===========================================
# REALTIME SERVICE (Socket.io - requires separate hosting)
# This CANNOT run on Vercel - needs Railway, Render, Fly.io, etc.
# ===========================================
# URL where your Socket.io realtime service is hosted
REALTIME_SERVICE_URL=http://localhost:3001
# Internal API URL for the realtime service
REALTIME_API_URL=http://localhost:3002

# ===========================================
# Payment Gateways (Uganda) - DISABLED, cash only for now
# Will be enabled when merchant of record SDK is integrated
# ===========================================
MTN_MOMO_ENVIRONMENT=sandbox
AIRTEL_MONEY_ENVIRONMENT=sandbox
# Uncomment and configure when ready to enable mobile money:
# FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
# MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_momo_subscription_key
# MTN_MOMO_API_USER=your_mtn_momo_api_user
# MTN_MOMO_API_KEY=your_mtn_momo_api_key
# AIRTEL_MONEY_CLIENT_ID=your_airtel_client_id
# AIRTEL_MONEY_CLIENT_SECRET=your_airtel_client_secret

# ===========================================
# SMS / OTP Configuration (Africa's Talking)
# Get from: https://account.africastalking.com/
# DISABLED for now - will configure later
# ===========================================
SMS_ENABLED=false
SMS_PROVIDER=africas_talking
AFRICASTALKING_API_KEY=your_africas_talking_api_key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=SmartRide
# Development only: set to 'true' to include OTP in API response
# NEVER enable in production — this is for testing only
ALLOW_OTP_IN_RESPONSE=false
